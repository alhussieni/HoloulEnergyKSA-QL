+function pfApply(){
+  const root = document.getElementById('pfRoot'); if(!root) return;
+  const num = v => (v===''||v==null||!isFinite(+v)) ? null : +v;
+  const min = num(pfUi.min), max = num(pfUi.max);
+  const rows = [...root.querySelectorAll('tr[data-pfrow]')];
+  let avail = 0, shown = 0;
+  rows.forEach(tr=>{
+    const vis = tr.dataset.vis==='1', priced = tr.dataset.priced==='1', ok = vis && priced, pw = +tr.dataset.power;
+    tr.dataset.avail = ok ? '1' : '0';
+    const st = tr.querySelector('[data-pfstate]'); if(st) st.innerHTML = pfBadges(vis, priced);
+    tr.style.opacity = ok ? '' : '.62';
+    if(ok) avail++;
+    let m = true;
+    if(pfUi.status==='avail' && !ok) m = false;
+    if(pfUi.status==='unavail' && ok) m = false;
+    if(pfUi.brands.size && !pfUi.brands.has(tr.dataset.brand)) m = false;
+    if(min!=null && pw<min) m = false;
+    if(max!=null && pw>max) m = false;
+    tr.hidden = !m; if(m) shown++;
+  });
+  root.querySelectorAll('.pf-group').forEach(g=>{
+    const rs = [...g.querySelectorAll('tr[data-pfrow]')];
+    const vis = rs.filter(r=>!r.hidden).length, av = rs.filter(r=>r.dataset.avail==='1').length;
+    const pws = rs.map(r=>+r.dataset.power).filter(x=>x>0);
+    const lo = pws.length ? Math.min(...pws) : 0, hi = pws.length ? Math.max(...pws) : 0;
+    const range = !pws.length ? '' : (lo===hi ? lo+'W' : lo+'–'+hi+'W');
+    const col = pfUi.collapsed.has(g.dataset.pfgroup);
+    g.hidden = vis===0;
+    const head = g.querySelector('.pf-ghead'); head.setAttribute('aria-expanded', col ? 'false' : 'true');
+    g.querySelector('.pf-gbody').hidden = col;
+    g.querySelector('[data-pfmeta]').innerHTML =
+      `<span class="pf-pill">${vis===rs.length ? rs.length+' لوح' : vis+' من '+rs.length+' لوح'}</span>`
+      + (range ? `<span class="pf-pill">${range}</span>` : '')
+      + `<span class="pf-pill ${av?'good':''}">متاح ${av}/${rs.length}</span>`;
+  });
+  root.querySelectorAll('[data-pfstatus]').forEach(b=>b.classList.toggle('on', b.dataset.pfstatus===pfUi.status));
+  root.querySelectorAll('[data-pfbrand]').forEach(b=>{ const on = pfUi.brands.has(b.dataset.pfbrand); b.classList.toggle('on', on); b.setAttribute('aria-pressed', on?'true':'false'); });
+  const set = (k,v)=>{ const el = root.querySelector(`[data-pfcnt="${k}"]`); if(el) el.textContent = '('+v+')'; };
+  set('all', rows.length); set('avail', avail); set('unavail', rows.length-avail);
+  const active = pfUi.status!=='all' || pfUi.brands.size>0 || min!=null || max!=null;
+  const clr = root.querySelector('#pf_clear'); if(clr) clr.disabled = !active;
+  const cnt = root.querySelector('#pf_count'); if(cnt) cnt.textContent = `عرض ${shown} من ${rows.length} لوح`;
+  const emp = root.querySelector('#pf_empty'); if(emp) emp.hidden = shown!==0;
+}
