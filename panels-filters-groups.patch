+function pfRenderPanels(){
+  const panels = adminConfig.panels || [];
+  const map = new Map();
+  panels.forEach((p,i)=>{
+    const k = pfBrandKey(p.brand);
+    if(!map.has(k)) map.set(k, { key:k, rows:[], names:{} });
+    const g = map.get(k), n = String(p.brand||'').trim();
