+  });
+  const groups = [...map.values()].map(g=>{
+    // اسم العرض للعائلة: الأكتر استخدامًا، ولو متساويين يبقى اللي فيه حروف كبيرة أكتر (JA)
+    const upp = s => s.replace(/[^A-Z]/g,'').length;
+    const names = Object.entries(g.names).sort((a,b)=> b[1]-a[1] || upp(b[0])-upp(a[0]));
+    g.label = (names[0] && names[0][0]) || '—';
+    g.rows.sort((a,b)=> (Number(a.p.power)||0)-(Number(b.p.power)||0) || a.i-b.i);
+    return g;
+  }).sort((a,b)=> a.label.localeCompare(b.label, 'en', {sensitivity:'base', numeric:true}));
+
+  // نظّف أي براند محدد في الفلتر ما بقاش موجود (بعد حذف/تعديل)
+  [...pfUi.brands].forEach(k=>{ if(!map.has(k)) pfUi.brands.delete(k); });
+
+  const pw = panels.map(p=>Number(p.power)||0).filter(x=>x>0);
+  const pwMin = pw.length ? Math.min(...pw) : '', pwMax = pw.length ? Math.max(...pw) : '';
+
+  const chips = groups.map(g=>`<button type="button" class="pf-chip" data-pfbrand="${pnlEsc(g.key)}" aria-pressed="false">${pnlEsc(g.label)} <b>${g.rows.length}</b></button>`).join('');
+
+  const groupsHtml = groups.map(g=>`
